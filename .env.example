# Only set the keys for the providers you actually want to test against —
# each is optional and independent. Restart the dev server after editing.

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (GPT) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# "Custom" provider (self-hosted / personal models — e.g. Ollama, vLLM, LM Studio)
# needs no env var: its base URL, model, and optional key are entered in the app's
# model picker at request time, since there's no shared secret to protect for a
# local, single-user endpoint.
